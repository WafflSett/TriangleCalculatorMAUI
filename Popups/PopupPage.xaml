<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Color="Transparent"
             x:Class="TriangleCalculatorMAUI.Popups.PopupPage">
    <Border BackgroundColor="White" Stroke="Transparent" Padding="0" StrokeShape="RoundRectangle, 25">
        <Grid RowDefinitions="*,2*,*" RowSpacing="5" HeightRequest="150" WidthRequest="250" Margin="20">
            <Label Text="{Binding Header}" HorizontalOptions="Center" FontAttributes="Bold" FontSize="18"/>
            <Label Text="{Binding Description}" HorizontalOptions="Center" Grid.Row="1"/>
            <Button x:Name="Close_BTN" Padding="30, 5" Text="Close" Grid.Row="2" Clicked="Close_BTN_Clicked" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
    </Border>
</toolkit:Popup>
